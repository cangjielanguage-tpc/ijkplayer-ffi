       let res :Future<String> = spawn {
            Hilog.error(0x0000,"testhhs","10")
            if (allowCachedFileUri && this.isCached(url)) {
                Hilog.error(0x0000,"dddddddd","localcache")
                let cacheFile = this.getCacheFile(url)
                this.touchFileSafely(cacheFile)
                return cacheFile
            }
